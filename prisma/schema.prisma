generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  name                    String
  bio                     String?
  avatarUrl               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  username                String?                  @unique
  story                   String?
  favArtist               String?
  favPlaylist             String?
  favSong                 String?
  spotifyAcc              String?
  cardTheme               String                   @default("default")
  customBgImageUrl        String?
  profileTemplate         String                   @default("classic")
  deactivated             Boolean                  @default(false)
  socialConnects   SocialConnect[] 
  emailVerificationTokens EmailVerificationToken[]
  links                   Link[]
  showcases              Showcase[]
  accounts                Account[]
  sessions                Session[]

  @@map("user")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Link {
  id        String   @id @default(cuid())
  label     String
  url       String
  platform  String?
  visible   Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Showcase {
  id          String         @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  ownerId     String
  createdAt   DateTime       @default(now())
  action      ShowcaseAction @default(Publish)
  owner       User           @relation(fields: [ownerId], references: [id])
  blocks      ShowcaseBlock[]

  @@map("Product")
}

enum BlockType {
  paragraph
  heading
  subheading
  image
  video
  link
  quote
  gallery
}

model ShowcaseBlock {
  id         String   @id @default(cuid())
  showcaseId String
  type       BlockType
  content    String?
  mediaUrl   String?
  caption    String?
  order      Int
  metadata   Json?
  createdAt  DateTime @default(now())
  showcase   Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  @@index([showcaseId])
}
model SocialConnect {
  id        String   @id @default(cuid())
  userId    String
  platform  String   // instagram, facebook, github, linkedin, etc
  url       String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform]) // one link per platform per user
  @@map("social_connect")
}
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ShowcaseAction {
  Publish
  Draft

  @@map("ProductAction")
}

model Report {
  id         String       @id @default(cuid())
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(Pending)
  reporterId String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([targetType, targetId])
  @@index([status])
}

enum ReportStatus {
  Pending
  Reviewed
  Dismissed
}

model PageView {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
